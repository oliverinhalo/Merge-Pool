<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MergePool.Fs.WinFsp</RootNamespace>
    <AssemblyName>MergePool.Fs.WinFsp</AssemblyName>
    <IsWindowsOnlyProject>true</IsWindowsOnlyProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <!--
    WinFsp ships its managed assembly with the product rather than on NuGet, so it is referenced
    from the install directory. The installer guarantees WinFsp is present on end-user machines.
  -->
  <PropertyGroup>
    <WinFspBinDir Condition="'$(WinFspBinDir)' == '' AND Exists('$(MSBuildProgramFiles32)\WinFsp\bin\winfsp-msil.dll')">$(MSBuildProgramFiles32)\WinFsp\bin\</WinFspBinDir>
    <WinFspBinDir Condition="'$(WinFspBinDir)' == '' AND Exists('$(ProgramW6432)\WinFsp\bin\winfsp-msil.dll')">$(ProgramW6432)\WinFsp\bin\</WinFspBinDir>
    <WinFspBinDir Condition="'$(WinFspBinDir)' == '' AND Exists('$(ProgramFiles)\WinFsp\bin\winfsp-msil.dll')">$(ProgramFiles)\WinFsp\bin\</WinFspBinDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(WinFspBinDir)' != ''">
    <Reference Include="winfsp-msil">
      <HintPath>$(WinFspBinDir)winfsp-msil.dll</HintPath>
      <Private>true</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  <Target Name="RequireWinFsp" BeforeTargets="ResolveReferences" Condition="'$(WinFspBinDir)' == '' AND '$(OS)' == 'Windows_NT'">
    <Error Text="WinFsp was not found. Install it from https://winfsp.dev or set WinFspBinDir to the folder containing winfsp-msil.dll." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MergePool.Core\MergePool.Core.csproj" />
  </ItemGroup>

</Project>
