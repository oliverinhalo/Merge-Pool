<Window x:Class="MergePool.Ui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:MergePool.Ui.ViewModels.Settings"
        Title="MergePool" Height="860" Width="1280" MinHeight="620" MinWidth="980"
        Background="{DynamicResource WindowBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="pack://application:,,,/Assets/MergePool.ico">

  <Window.Resources>
    <!--
      How a setting draws itself. Every setting in the window goes through one of these two
      templates, so none of them can end up on screen without its name, its value in words, what it
      does, what moving it costs, the value it ships with and a way back to it.
    -->

    <!-- A setting with a range: a slider, labelled ends, and a sentence about where it is. -->
    <DataTemplate DataType="{x:Type settings:NumericSetting}">
      <Border Style="{StaticResource SettingCard}"
              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
              ToolTip="{Binding Help}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                         TextWrapping="Wrap" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBrush}" />
              <Border Style="{StaticResource ChangedPill}"
                      Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="changed" Style="{StaticResource ChangedText}" />
              </Border>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource ValuePill}" Margin="10,0,0,0">
              <TextBlock Text="{Binding ValueText}" Style="{StaticResource ValueText}" />
            </Border>
          </Grid>

          <Slider Style="{StaticResource SettingSlider}" Margin="0,10,0,0"
                  ToolTip="{Binding Help}"
                  Minimum="{Binding Minimum, Mode=OneTime}"
                  Maximum="{Binding Maximum, Mode=OneTime}"
                  TickFrequency="{Binding Step, Mode=OneTime}"
                  SmallChange="{Binding Step, Mode=OneTime}"
                  Value="{Binding Value, Mode=TwoWay}" />

          <Grid Margin="0,0,0,8">
            <TextBlock Text="{Binding MinimumText}" Style="{StaticResource Caption}" FontSize="11"
                       HorizontalAlignment="Left" />
            <TextBlock Text="{Binding MaximumText}" Style="{StaticResource Caption}" FontSize="11"
                       HorizontalAlignment="Right" />
          </Grid>

          <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Margin="0,0,0,6" />
          <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
          <TextBlock Text="{Binding Effect}" Style="{StaticResource Caption}" Margin="0,0,0,6" />

          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center">
              <Run Text="Ships as" /><Run Text=" " /><Run Text="{Binding DefaultText, Mode=OneWay}" />
            </TextBlock>
            <Button Content="Put this one back" Style="{StaticResource QuietButton}" Margin="10,0,0,0"
                    Command="{Binding ResetCommand}"
                    ToolTip="Sets this one setting back to the value MergePool ships with. Nothing else on this tab is touched."
                    Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A setting that is on or off, with a sentence for the state it is actually in. -->
    <DataTemplate DataType="{x:Type settings:ToggleSetting}">
      <Border Style="{StaticResource SettingCard}"
              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
              ToolTip="{Binding Help}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <ToggleButton Style="{StaticResource SettingSwitch}" ToolTip="{Binding Help}"
                          IsChecked="{Binding IsOn, Mode=TwoWay}">
              <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                         TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
            </ToggleButton>
            <Border Style="{StaticResource ChangedPill}"
                    Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibility}}">
              <TextBlock Text="changed" Style="{StaticResource ChangedText}" />
            </Border>
          </StackPanel>

          <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Margin="0,0,0,6" />
          <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
          <TextBlock Text="{Binding Effect}" Style="{StaticResource Caption}" Margin="0,0,0,6" />

          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center">
              <Run Text="Ships as" /><Run Text=" " /><Run Text="{Binding DefaultText, Mode=OneWay}" />
            </TextBlock>
            <Button Content="Put this one back" Style="{StaticResource QuietButton}" Margin="10,0,0,0"
                    Command="{Binding ResetCommand}"
                    ToolTip="Sets this one setting back to the value MergePool ships with. Nothing else on this tab is touched."
                    Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A named set of settings: what the set decides, then the settings themselves. -->
    <DataTemplate DataType="{x:Type settings:SettingGroup}">
      <StackPanel Margin="0,0,0,8"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
        <Grid Margin="0,6,0,2">
          <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" Margin="0"
                     HorizontalAlignment="Left" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ChangedText}" Style="{StaticResource Caption}" FontSize="11"
                     HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding Items}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <!-- Tooltips here are paragraphs, so they are given long enough to be read and a moment before
       they appear. Both settings are inherited by everything in the window. -->
  <Grid Margin="20,16,20,14" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="60000">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Image Source="pack://application:,,,/Assets/MergePool.ico" Width="30" Height="30"
               Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="MergePool" Style="{StaticResource Display}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,-2,0,0"
                     Text="Several drives, one drive letter. Your files stay ordinary files." />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <!--
          Advanced: one switch for the whole window. It changes nothing about what MergePool is
          doing — it only decides whether the expert tunables are on screen, and it is remembered.
        -->
        <ToggleButton Style="{StaticResource HeaderSwitch}" Content="Advanced" Margin="0,0,10,0"
                      IsChecked="{Binding ShowAdvanced, Mode=TwoWay}"
                      ToolTip="{Binding AdvancedHint}" />

        <!-- Connection state: the one thing worth knowing at a glance. -->
        <Border Style="{StaticResource Pill}" Margin="0,0,8,0"
                Background="{Binding IsConnected, Converter={StaticResource StatePillBrush}}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                     Fill="{Binding IsConnected, Converter={StaticResource StateDotBrush}}" />
            <TextBlock Text="{Binding ConnectionText}" FontSize="12"
                       Foreground="{Binding IsConnected, Converter={StaticResource StateTextBrush}}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Pill}">
          <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}">
            <Run Text="v" /><Run Text="{Binding ServiceVersion, Mode=OneWay}" />
          </TextBlock>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Banners -->
    <StackPanel Grid.Row="1">
      <!-- A problem that needs the user. -->
      <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
              BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="14,11" Margin="0,0,0,12"
              Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}" />
      </Border>

      <!-- An update waiting. Installing is one click; the service does the rest. -->
      <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
              BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="14,11" Margin="0,0,0,12"
              Visibility="{Binding Updates.UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Updates.Headline}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                       Text="Installing keeps every file where it is. The service restarts on the new version and your pools come straight back." />
            <ProgressBar Style="{StaticResource ThinUsageBar}" Margin="0,8,0,0" Width="320"
                         HorizontalAlignment="Left"
                         Visibility="{Binding Updates.IsInstalling, Converter={StaticResource BoolToVisibility}}"
                         Value="{Binding Updates.Progress, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
          </StackPanel>

          <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Install now"
                  VerticalAlignment="Center" Margin="14,0,0,0"
                  Command="{Binding Updates.InstallCommand}"
                  ToolTip="Downloads this version, checks it against its published checksum, unpacks it beside the running one and switches to it. Your pools are unmounted and remounted in the process and every file stays where it is." />
        </Grid>
      </Border>

      <!-- An update has already installed underneath this window. Reopening is the whole fix. -->
      <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
              BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="14,11" Margin="0,0,0,12"
              Visibility="{Binding Updates.WindowIsStale, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Updates.StaleHeadline}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                       Text="Your pools are already on the new version — the service restarted onto it. Only this window is behind, and reopening it changes nothing on your drives." />
          </StackPanel>

          <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Reopen MergePool"
                  VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="148"
                  Command="{Binding Updates.RestartWindowCommand}"
                  ToolTip="Closes this window and opens the version the service has already moved to. Your pools are not touched — they are on the new version either way; only this window is behind." />
        </Grid>
      </Border>
    </StackPanel>

    <!-- Body. The divider between the two panels is draggable, and where it is put is remembered. -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftPane" Width="1.25*" MinWidth="360" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition x:Name="RightPane" Width="1*" MinWidth="340" />
      </Grid.ColumnDefinitions>

      <!-- Left: the pools -->
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Pools" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Open" Command="{Binding OpenPoolCommand}" MinWidth="76" Margin="0,0,6,0"
                      ToolTip="Opens the pool's drive letter in File Explorer, so you see every pooled file from every drive in one place. Available while the pool is mounted." />
              <Button Content="Mount" Command="{Binding MountCommand}" MinWidth="76" Margin="0,0,6,0"
                      ToolTip="Makes the pool appear at its drive letter again. Mounting reads what is on the drives — it writes nothing and takes a second or two." />
              <Button Content="Unmount" Command="{Binding UnmountCommand}" MinWidth="82" Margin="0,0,6,0"
                      ToolTip="Takes the pool's drive letter away. The files stay exactly where they are, on their own drives, and come back the moment you mount it again. Anything with a file open on the pool will see it disappear." />
              <Button Content="Rebalance" Command="{Binding RebalanceCommand}" MinWidth="88" Margin="0,0,6,0"
                      ToolTip="Starts a pass now that moves files off the fullest drives onto the emptier ones, whole files at a time, verifying each copy before removing the original. It is rate-capped, gives way to real work, and skips anything in use. Nothing you can see inside the pool changes." />
              <Button Content="Remove pool" Style="{StaticResource DangerButton}" MinWidth="104" Margin="0"
                      Command="{Binding RemovePoolCommand}"
                      ToolTip="Forgets the pool: the drive letter goes away and MergePool stops serving it. Every file stays on the drive it was on, in that drive's .PoolPart folder, readable with MergePool uninstalled. Nothing is deleted." />
            </StackPanel>
          </Grid>

          <!-- Nothing yet: say what to do rather than showing an empty box. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource InsetCard}" Padding="24"
                  Visibility="{Binding Pools.Count, Converter={StaticResource ZeroToVisibility}}">
            <StackPanel>
              <TextBlock Text="No pools yet" Style="{StaticResource Heading}" Margin="0,0,0,6" />
              <TextBlock Style="{StaticResource Caption}"
                         Text="Tick some drives on the right, give the pool a name and a drive letter, and click Create pool. Nothing already on those drives is touched." />
            </StackPanel>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ListBox ItemsSource="{Binding Pools}" SelectedItem="{Binding SelectedPool}"
                     Style="{StaticResource PlainListBox}"
                     ItemContainerStyle="{StaticResource CardListItem}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource InsetBrush}" BorderThickness="1"
                          BorderBrush="{DynamicResource BorderBrush}"
                          CornerRadius="{StaticResource CardRadius}" Padding="16">
                    <StackPanel>

                      <!-- Pool name, mount point, health -->
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                          <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                                  Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="{Binding MountPoint}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" />
                          </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding Health}" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding Health, Converter={StaticResource StatusBrush}}" />
                      </Grid>

                      <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                 Text="{Binding HealthSummary}" />

                      <!-- The two figures that are easy to confuse, told apart. -->
                      <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="16" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                          <TextBlock Text="POOL" Style="{StaticResource Subheading}" />
                          <TextBlock Style="{StaticResource Metric}"
                                     Text="{Binding PoolUsedBytes, Converter={StaticResource ByteSize}}" />
                          <ProgressBar Style="{StaticResource UsageBar}" Margin="0,7,0,5"
                                       Value="{Binding PoolUsedFraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
                          <TextBlock Style="{StaticResource Caption}" Text="{Binding PoolUsageText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                          <TextBlock Text="DRIVES IN TOTAL" Style="{StaticResource Subheading}" />
                          <TextBlock Style="{StaticResource Metric}"
                                     Foreground="{DynamicResource MutedTextBrush}"
                                     Text="{Binding TotalBytes, Converter={StaticResource ByteSize}}" />
                          <ProgressBar Style="{StaticResource UsageBar}" Margin="0,7,0,5"
                                       Foreground="{DynamicResource ForeignBrush}"
                                       Value="{Binding DriveUsedFraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
                          <TextBlock Style="{StaticResource Caption}" Text="{Binding DriveUsageText}" />
                        </StackPanel>
                      </Grid>

                      <!-- Per-drive detail -->
                      <TextBlock Text="DRIVES IN THIS POOL" Style="{StaticResource Subheading}" Margin="0,18,0,8" />

                      <ListBox ItemsSource="{Binding Parts}" Style="{StaticResource PlainListBox}"
                               SelectedItem="{Binding DataContext.SelectedPart,
                                              RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                               ItemContainerStyle="{StaticResource CardListItem}">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource ControlRadius}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,10">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="{StaticResource ControlRadius}"
                                        Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0"
                                        VerticalAlignment="Top">
                                  <TextBlock Text="{Binding DriveLetter}" FontWeight="SemiBold" FontSize="13"
                                             Foreground="{DynamicResource AccentBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                             Foreground="{DynamicResource TextBrush}" />

                                  <!--
                                    Two bars in one: the grey one is everything the drive is using,
                                    the blue one on top is the part of it that is the pool's. What is
                                    left is free space.
                                  -->
                                  <Grid Margin="0,7,0,6">
                                    <ProgressBar Style="{StaticResource UsageBar}"
                                                 Foreground="{DynamicResource ForeignBrush}"
                                                 Value="{Binding DriveUsedFraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
                                    <ProgressBar Style="{StaticResource UsageBar}" Background="Transparent"
                                                 Value="{Binding PoolFraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
                                  </Grid>

                                  <TextBlock Style="{StaticResource Caption}" Text="{Binding UsageSummary}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="12,0,0,0" MinWidth="112">
                                  <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                             HorizontalAlignment="Right"
                                             Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                  <TextBlock Text="{Binding Throughput}" Style="{StaticResource Numeric}"
                                             HorizontalAlignment="Right" Margin="0,5,0,0" />
                                  <TextBlock Text="{Binding HealthRatio}" Style="{StaticResource Numeric}"
                                             HorizontalAlignment="Right" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <!-- Acting on the selected drive. Both routes are spelled out. -->
                      <Border Margin="0,4,0,0" Padding="12"
                              Background="{DynamicResource SurfaceBrush}">
                        <Border.Style>
                          <!--
                            Only in the card of the pool actually selected: the buttons act on the
                            selected drive, and that drive belongs to exactly one pool.
                          -->
                          <Style TargetType="Border" BasedOn="{StaticResource InsetCard}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding IsSelected,
                                             RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                  <Condition Binding="{Binding DataContext.CanRemoveDrive,
                                             RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <StackPanel>
                          <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8">
                            <Run Text="Selected drive:" />
                            <Run Text="{Binding DataContext.SelectedPart.DriveLetter,
                                        RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                 FontWeight="SemiBold" />
                            <Run Text="{Binding DataContext.SelectedPart.Label,
                                        RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                          </TextBlock>

                          <StackPanel Orientation="Horizontal">
                            <Button Content="Remove, keep files on it" MinWidth="164" Margin="0,0,8,0"
                                    Command="{Binding DataContext.DetachDriveCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="The drive leaves the pool. Its files stay on it, untouched, in its pool part folder." />
                            <Button Content="Move files off, then remove" MinWidth="176" Margin="0"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding DataContext.EvacuateDriveCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Moves this drive's pooled files onto the pool's other drives first, then removes it." />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Right: drives, settings, about -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <TabControl Style="{StaticResource SegmentedTab}">

          <!-- Drives -->
          <TabItem Header="Drives">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,12"
                         Text="Tick the drives you want. Create a new pool from them, or add them to the pool selected on the left. Anything already on a drive is left exactly where it is." />

              <!-- What happens to the ticked drives -->
              <Border DockPanel.Dock="Bottom" Style="{StaticResource InsetCard}" Margin="0,14,0,0">
                <StackPanel>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <TextBlock Text="POOL NAME" Style="{StaticResource Subheading}" />
                      <TextBox Text="{Binding PoolName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                      <TextBlock Text="DRIVE LETTER" Style="{StaticResource Subheading}" />
                      <ComboBox Width="86" ItemsSource="{Binding AvailableMountLetters}"
                                SelectedItem="{Binding SelectedMountLetter}" />
                    </StackPanel>
                  </Grid>

                  <CheckBox IsChecked="{Binding AdoptExistingContent}" Margin="0,0,0,14"
                            ToolTip="Off by default, and the only option here that touches files you already have. On, each drive's existing top-level files and folders are moved into that drive's pool part, so they show up inside the pool. It is a rename within the same drive — instant, and no data crosses between drives — but it does change where those files sit on the disk. Windows and system folders are never moved.">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Text="Also move each drive's existing files into the pool. A rename within the same drive — nothing is copied between drives, and Windows folders are never touched. Leave this off if the data is irreplaceable." />
                  </CheckBox>

                  <StackPanel Orientation="Horizontal">
                    <Button Content="Create pool" Style="{StaticResource PrimaryButton}" MinWidth="128"
                            Margin="0,0,8,0" Command="{Binding CreatePoolCommand}"
                            ToolTip="Makes a new pool from the ticked drives at the drive letter chosen above. Each drive gets a .PoolPart folder at its root and nothing else on it is touched. Needs a name, a free drive letter and at least one ticked drive." />
                    <Button MinWidth="148" Margin="0" Content="{Binding AddDrivesLabel}"
                            Command="{Binding AddDrivesCommand}"
                            ToolTip="Adds the ticked drives to the selected pool. The pool stays mounted throughout." />
                  </StackPanel>
                </StackPanel>
              </Border>

              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding Drives}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource InsetBrush}" CornerRadius="{StaticResource ControlRadius}"
                              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                              Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0"
                                    IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanBePooled}"
                                    ToolTip="Ticks this drive for the next Create pool or Add drives. Ticking nothing else and changing nothing on the drive — it is a selection, not an action. A drive that cannot be pooled, such as the one Windows is on or a read-only volume, cannot be ticked." />

                          <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding DriveLetter}" FontWeight="SemiBold" FontSize="13"
                                         Foreground="{DynamicResource TextBrush}" Margin="0,0,8,0" />
                              <TextBlock Text="{Binding Label}" FontSize="13"
                                         Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <ProgressBar Style="{StaticResource ThinUsageBar}" Margin="0,7,10,5"
                                         Value="{Binding UsedFraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />

                            <TextBlock Style="{StaticResource Caption}">
                              <Run Text="{Binding FreeBytes, Mode=OneWay, Converter={StaticResource ByteSize}}" />
                              <Run Text="free of" />
                              <Run Text="{Binding TotalBytes, Mode=OneWay, Converter={StaticResource ByteSize}}" />
                              <Run Text="·" />
                              <Run Text="{Binding FileSystem, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>

                          <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center"
                                     FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"
                                     Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </TabItem>

          <!-- Settings: how MergePool decides things, everyday ones first -->
          <TabItem Header="Settings">
            <DockPanel>

              <!--
                The footer, not a button at the bottom of a long page: the settings list is long
                enough that a Save you have scrolled past is a Save you will forget. It also says
                whether anything is waiting to be sent.
              -->
              <Border DockPanel.Dock="Bottom" Style="{StaticResource InsetCard}" Margin="0,12,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Save settings" Style="{StaticResource PrimaryButton}" MinWidth="124"
                            Margin="0,0,8,0" Command="{Binding Settings.SaveCommand}"
                            ToolTip="Sends every setting on this tab to the MergePool service and writes them to its configuration. Nothing already in your pools moves; the change applies to the next file placed and to the next rebalance." />
                    <Button Content="Back to defaults" MinWidth="124"
                            Command="{Binding Settings.ResetCommand}"
                            ToolTip="Puts every setting on this tab — the advanced ones included — back to the value MergePool ships with, and saves that. Your pools, drives and protected folders are not affected." />
                  </StackPanel>

                  <TextBlock Text="{Binding Settings.ChangeText}" Style="{StaticResource Caption}" />
                  <TextBlock Text="{Binding Settings.Message}" Style="{StaticResource Caption}"
                             Margin="0,6,0,0" />
                </StackPanel>
              </Border>

              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                  <TextBlock Text="How MergePool decides things" Style="{StaticResource Heading}" />
                  <TextBlock Text="{Binding Settings.ScopeText}" Style="{StaticResource Body}"
                             Margin="0,0,0,4" />
                  <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                             Text="Every setting here is about what MergePool does next: which drive a new file goes to, when a drive is considered slow, and how hard it may work in the background. None of them move or rewrite anything you have already stored." />

                  <!-- Each group and each setting draws itself; see the templates at the top. -->
                  <ItemsControl ItemsSource="{Binding Settings.Groups}" />

                  <!-- Updates and start-up: the service's doing, so it is not part of Save. -->
                  <TextBlock Text="Updates and start-up" Style="{StaticResource Heading}" Margin="0,10,0,2" />
                  <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                             Text="These take effect the moment you set them — there is nothing to save. An update only ever adds a new version folder and switches which one runs." />

                  <Border Style="{StaticResource InsetCard}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource Body}" Text="{Binding Updates.Headline}" Margin="0,0,0,4" />
                      <TextBlock Style="{StaticResource Caption}" Text="{Binding Updates.LastChecked}" Margin="0,0,0,12" />

                      <CheckBox IsChecked="{Binding Updates.AutomaticChecks, Mode=TwoWay}" Margin="0,0,0,10"
                                ToolTip="Asks the release feed whether there is a newer MergePool, on the schedule under Advanced. A check downloads nothing by itself.">
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="Check for new versions automatically. One small request on a timer; it downloads nothing unless there is something newer." />
                      </CheckBox>
                      <CheckBox IsChecked="{Binding Updates.AutomaticInstall, Mode=TwoWay}" Margin="0,0,0,10"
                                ToolTip="Installs a newer version as soon as it is found, without waiting to be asked. Off means the banner at the top of the window waits for you to click Install now.">
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="Install them without asking. An update only adds a new version folder and switches which one runs — your pools and files are never touched, and a version that fails to come up is rolled back." />
                      </CheckBox>
                      <CheckBox IsChecked="{Binding Updates.SeamlessRestart, Mode=TwoWay}" Margin="0,0,0,10"
                                ToolTip="After an update, this window closes and opens again on the new version by itself. Your pools are already on the new version either way — the service restarts onto it immediately.">
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="Reopen this window on the new version by itself. An update installs, the service restarts onto it, and the window follows — nothing to click. Off means it waits and asks." />
                      </CheckBox>
                      <CheckBox IsChecked="{Binding Updates.StartWithWindows, Mode=TwoWay}" Margin="0,0,0,14"
                                ToolTip="Adds MergePool's window to this user's own start-up entries, opening it in the notification area. The MergePool service starts with Windows regardless, so your pools are mounted either way.">
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="Open this window in the notification area when I sign in. The pools are mounted by the service either way, whether or not the window is open." />
                      </CheckBox>

                      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Check now" MinWidth="112" Margin="0,0,8,0"
                                Command="{Binding Updates.CheckCommand}"
                                ToolTip="Asks the release feed right now whether there is a newer version, whatever the schedule says. Nothing is installed by checking." />
                        <Button Content="Install now" Style="{StaticResource PrimaryButton}" MinWidth="112"
                                Command="{Binding Updates.InstallCommand}"
                                ToolTip="Downloads the version that was found, checks it against its published checksum, unpacks it beside the running one and switches to it. Your pools come straight back; a version that does not come up healthy is rolled back." />
                      </StackPanel>

                      <TextBlock Style="{StaticResource Caption}" Text="{Binding Updates.Message}" />
                      <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                 Foreground="{DynamicResource DangerBrush}"
                                 Text="{Binding Updates.Problem}" />
                      <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0">
                        <Run Text="Versions installed:" />
                        <Run Text="{Binding Updates.InstalledVersionsText, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>

                  <!-- Hidden until Advanced is on; the defaults are what a machine being relied on
                       should be running. -->
                  <ContentControl Content="{Binding Updates.Advanced}" Margin="0,16,0,0" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </TabItem>

          <!-- Folders kept on more than one drive -->
          <TabItem Header="Protected">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
              <StackPanel>
                <TextBlock Text="Folders kept on more than one drive" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8"
                           Text="Pick a folder inside the pool and MergePool keeps every file in it on several drives at once. Lose a drive and the files are still there, on the others. The copies are ordinary files in the usual place on each drive, so they are readable with MergePool uninstalled." />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                           Text="This is not a backup of your computer: copies live on the pool's own drives, so it survives a drive dying, not a fire, a theft or deleting the file yourself." />

                <TextBlock Text="{Binding Duplication.Headline}" Style="{StaticResource Body}"
                           FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />

                <!-- What is protected now -->
                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="PROTECTED FOLDERS" Style="{StaticResource Subheading}" />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                               Visibility="{Binding Duplication.Folders.Count, Converter={StaticResource ZeroToVisibility}}"
                               Text="No folder in this pool is protected yet. Describe one below, or protect the whole pool in one go." />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                               Text="Click a folder to change how many copies it keeps, or to pause or stop protecting it." />

                    <ListBox ItemsSource="{Binding Duplication.Folders}"
                             SelectedItem="{Binding Duplication.Selected, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" MaxHeight="280"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,4,0,8">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>

                              <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,8,0"
                                       Fill="{Binding IsSatisfied, Converter={StaticResource StateDotBrush}}" />

                              <!-- A folder path can be long and the panel is resizable, so it wraps. -->
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Folder}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding Copies}" Style="{StaticResource Caption}" />
                              </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" Margin="16,2,0,0" />
                            <TextBlock Text="{Binding Extras}" Style="{StaticResource Caption}" Margin="16,2,0,0" />
                            <TextBlock Text="{Binding Problems}" Style="{StaticResource Caption}" Margin="16,2,0,0"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <Button Content="Check now" MinWidth="104" Margin="0,0,6,0"
                              Command="{Binding Duplication.RunNowCommand}"
                              ToolTip="Go over the protected folders now rather than waiting for the next sweep." />
                      <Button Content="{Binding Duplication.PauseLabel}" MinWidth="96" Margin="0,0,6,0"
                              Command="{Binding Duplication.TogglePauseCommand}"
                              ToolTip="Stops this one folder being copied, leaving the rule and every copy already made in place. Resume picks it up where it left off." />
                      <Button Content="Stop protecting" MinWidth="128"
                              Style="{StaticResource DangerButton}"
                              Command="{Binding Duplication.RemoveCommand}"
                              ToolTip="Stops making copies of this folder. Nothing already on your drives is deleted." />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Adding one, or changing the one picked above -->
                <TextBlock Text="{Binding Duplication.EditorHeading}" Style="{StaticResource Subheading}" />
                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="FOLDER INSIDE THE POOL" Style="{StaticResource Subheading}" />
                    <TextBox Text="{Binding Duplication.NewFolder, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                               Text="For example Photos, or Photos\2026 — as the folder appears inside the pool, not a full Windows path." />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                               Text="{Binding Duplication.EditorHint}" />

                    <CheckBox IsChecked="{Binding Duplication.NewEveryDrive, Mode=TwoWay}" Margin="0,0,0,10"
                              ToolTip="Instead of a fixed number of copies, keep one on every drive the pool has — including drives added later. Uses the most space of any setting here and survives the most drives failing at once.">
                      <TextBlock TextWrapping="Wrap" FontSize="13"
                                 Text="Keep a copy on every drive in the pool, however many drives it ends up having" />
                    </CheckBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                IsEnabled="{Binding Duplication.NewEveryDrive, Converter={StaticResource NotBool}}">
                      <TextBlock Text="Copies" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Foreground="{DynamicResource TextBrush}" FontSize="13" />
                      <Slider Width="220" Minimum="2" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                              Style="{StaticResource SettingSlider}" VerticalAlignment="Center"
                              Value="{Binding Duplication.NewCopies, Mode=TwoWay}"
                              ToolTip="How many drives hold a copy of each file in this folder. Two survives one drive dying, three survives two at once. A pool cannot hold more copies than it has drives — MergePool says so rather than quietly rounding down — and two copies are never put on the same drive." />
                      <TextBlock Text="{Binding Duplication.NewCopies}" Style="{StaticResource Numeric}"
                                 VerticalAlignment="Center" Margin="10,0,0,0"
                                 Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Duplication.CopiesText}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />

                    <CheckBox IsChecked="{Binding Duplication.NewVerifyByContent, Mode=TwoWay}" Margin="0,0,0,10"
                              ToolTip="Normally a copy is considered good if its size and last-write time match. On, every byte of every copy is read and compared on each sweep instead, which catches a copy that has rotted on the disk without looking any different. It costs a full read of the folder each sweep, so it suits archives rather than folders you are actively writing to.">
                      <TextBlock TextWrapping="Wrap" FontSize="13"
                                 Text="Compare copies byte for byte, not just by size and date. This catches a copy that has gone bad on the disk without looking any different. It reads every byte of every copy each time it sweeps, so leave it off unless you want that." />
                    </CheckBox>

                    <CheckBox IsChecked="{Binding Duplication.NewKeepSurplus, Mode=TwoWay}" Margin="0,0,0,14"
                              ToolTip="Decides what happens to copies the rule no longer asks for — after you lower the number of copies, or a drive rejoins carrying an old one. Off, the spares are deleted so the disks match the rule. On, MergePool only ever adds copies and never removes one, which uses more space but means no automatic deletion ever happens.">
                      <TextBlock TextWrapping="Wrap" FontSize="13"
                                 Text="Never delete a copy. Leave this off and asking for fewer copies removes the spare ones; turn it on and MergePool only ever adds copies, never takes one away." />
                    </CheckBox>

                    <StackPanel Orientation="Horizontal">
                      <Button Content="{Binding Duplication.SaveLabel}" Style="{StaticResource PrimaryButton}"
                              MinWidth="152" Margin="0,0,6,0" Command="{Binding Duplication.AddCommand}"
                              ToolTip="Saves this folder's rule. Copies are made in the background from the next sweep onwards; nothing is copied while you are typing, and no file is ever deleted to satisfy a new rule." />
                      <Button Content="Protect the whole pool" MinWidth="168" Margin="0,0,6,0"
                              Command="{Binding Duplication.ProtectEverythingCommand}"
                              ToolTip="Every file in the pool, including ones added later."
                              Visibility="{Binding Duplication.IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                      <Button Content="Cancel" MinWidth="96"
                              Command="{Binding Duplication.StopEditingCommand}"
                              ToolTip="Stop changing this folder and describe a new one instead."
                              Visibility="{Binding Duplication.IsEditing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Text="{Binding Duplication.Message}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <TextBlock Text="COPYING" Style="{StaticResource Subheading}" />
                <Border Style="{StaticResource InsetCard}">
                  <StackPanel>
                    <CheckBox IsChecked="{Binding Duplication.Enabled, Mode=TwoWay}"
                              ToolTip="The master switch for copying, across every pool and every protected folder. Off, the rules stay exactly as they are and nothing is copied or removed until you turn it back on.">
                      <TextBlock TextWrapping="Wrap" FontSize="13"
                                 Text="Keep protected folders up to date in the background. Off pauses all copying everywhere; the copies already made are left alone." />
                    </CheckBox>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Text="Copying is rate-capped and gives way to whatever else is using the drives, the same as evening out drive usage does. A file something has open is left for the next sweep. Turn on Advanced, in the title bar, to set the rate, how often it looks and how much room it leaves." />
                  </StackPanel>
                </Border>

                <!-- How the copying is paced. Hidden until Advanced is on. -->
                <ContentControl Content="{Binding Duplication.Advanced}" Margin="0,16,0,0" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Controlling MergePool from a browser -->
          <TabItem Header="Remote">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
              <StackPanel>
                <TextBlock Text="Control MergePool from a browser" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,14"
                           Text="Turn this on and MergePool answers on a port of your choosing: the same pools, drives and controls as this window, in a browser on this computer or on your phone. The service does the serving, so it keeps working whether or not this window is open." />

                <!-- One button for the whole thing: on, and open, already signed in. The same action
                     is in the notification-area menu, which is where people look for it. -->
                <Button Content="Open the web page" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" MinWidth="176" Margin="0,0,0,6"
                        Command="{Binding Web.OpenWebPageCommand}"
                        ToolTip="Does the whole thing in one click: turns the web interface on if it is off, on the port below, and opens it in your browser already signed in. Nothing is exposed to your network unless you tick that separately." />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16"
                           Text="Turns it on if it is off, on the port below, and opens it in your browser signed in. It is also in the MergePool menu in the notification area." />

                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,16">
                  <StackPanel>
                    <CheckBox IsChecked="{Binding Web.Enabled, Mode=TwoWay}" Margin="0,0,0,12"
                              ToolTip="Starts the web interface inside the MergePool service on the port below. Off, nothing is listening at all. On and left as it comes, only this computer can connect, and only with the access token.">
                      <TextBlock TextWrapping="Wrap" FontSize="13"
                                 Text="Control MergePool from a browser. The service does the serving, so it works whether or not this window is open." />
                    </CheckBox>

                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0">
                        <TextBlock Text="PORT" Style="{StaticResource Subheading}" />
                        <TextBox Width="110" Text="{Binding Web.PortText, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>

                      <Button Grid.Column="2" Content="Use this port" VerticalAlignment="Bottom" MinWidth="112"
                              Command="{Binding Web.ApplyPortCommand}"
                              ToolTip="Moves the web interface to the port typed here. Any browser on the old port loses its connection and has to be pointed at the new one." />
                    </Grid>

                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Web.PortHint}" Margin="0,0,0,12" />

                    <CheckBox IsChecked="{Binding Web.ReachableFromNetwork, Mode=TwoWay}" Margin="0,0,0,10"
                              ToolTip="Off, the interface is bound to this computer's loopback address and nothing on your network can reach it. On, it binds to the machine's addresses, so any device that can reach this PC — and holds the token — can use it. The connection is plain HTTP, so treat it as a home-network convenience, not something to expose to the internet.">
                      <TextBlock TextWrapping="Wrap" FontSize="13"
                                 Text="Let other devices on my network reach it. Off means only this computer can connect." />
                    </CheckBox>

                    <CheckBox IsChecked="{Binding Web.AllowChanges, Mode=TwoWay}" Margin="0,0,0,10"
                              ToolTip="Off, the browser is read-only: it shows pools, drives and usage and refuses anything that would change them. On, it can mount, unmount, rebalance and take drives out, the same as this window. It can never delete your files either way.">
                      <TextBlock TextWrapping="Wrap" FontSize="13"
                                 Text="Let the browser make changes. Off means it can see the pools but not mount, unmount, rebalance or touch drives." />
                    </CheckBox>

                    <CheckBox IsChecked="{Binding Web.ManageFirewallRule, Mode=TwoWay}" Margin="0,0,0,14"
                              ToolTip="Lets MergePool add a Windows Firewall rule for its own port while the interface is on, and remove it again when you turn it off or change the port. Off, you open the port yourself — or other devices simply cannot connect.">
                      <TextBlock TextWrapping="Wrap" FontSize="13"
                                 Text="Open the port in Windows Firewall while this is on, and close it again afterwards." />
                    </CheckBox>

                    <!-- What it is doing right now, in its own words. -->
                    <Border CornerRadius="{StaticResource ControlRadius}" Padding="11,9" Margin="0,0,0,12"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                      <StackPanel>
                        <TextBlock Text="{Binding Web.StateText}" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text="{Binding Web.TrafficText}"
                                   Visibility="{Binding Web.IsListening, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>
                    </Border>

                    <TextBlock Text="ACCESS TOKEN" Style="{StaticResource Subheading}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                               Text="A browser has to present this to see or change anything. Type it in once on the sign-in page." />

                    <Border CornerRadius="{StaticResource ControlRadius}" Padding="10,8" Margin="0,0,0,10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                      <TextBlock Text="{Binding Web.DisplayedToken}" Style="{StaticResource Numeric}"
                                 FontSize="13" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextBrush}" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                      <CheckBox IsChecked="{Binding Web.IsTokenVisible, Mode=TwoWay}" Content="Show"
                                VerticalAlignment="Center" Margin="0,0,14,0"
                                ToolTip="Reveals the token above so you can read it off the screen. It is hidden by default so it is not caught by a screenshot or someone behind you." />
                      <Button Content="Copy token" MinWidth="104" Margin="0,0,6,0"
                              Command="{Binding Web.CopyTokenCommand}"
                              ToolTip="Copies the access token to the clipboard, ready to paste into the browser's sign-in page. Treat it like a password: anyone holding it can do whatever the settings here allow." />
                      <Button Content="New token" MinWidth="104" Margin="0,0,6,0"
                              Style="{StaticResource DangerButton}"
                              Command="{Binding Web.RegenerateTokenCommand}"
                              ToolTip="Signs out every browser using the old token." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="{Binding Web.IsListening, Converter={StaticResource BoolToVisibility}}">
                      <Button Content="Open in browser" Style="{StaticResource PrimaryButton}" MinWidth="136"
                              Margin="0,0,6,0" Command="{Binding Web.OpenCommand}"
                              ToolTip="Opens the web interface in your default browser, already signed in with the token above." />
                      <Button Content="Copy address" MinWidth="112" Command="{Binding Web.CopyUrlCommand}"
                              ToolTip="Copies the address the interface is listening on, to paste into a browser on another device. Without the token, that browser sees only the sign-in page." />
                    </StackPanel>

                    <!-- Plain HTTP on a LAN. Say so where the decision is made, not only in the docs. -->
                    <Border CornerRadius="{StaticResource ControlRadius}" Padding="11,9"
                            Background="{DynamicResource WarningSoftBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                            Visibility="{Binding Web.ReachableFromNetwork, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{Binding Web.SecurityNote}" TextWrapping="Wrap" FontSize="12"
                                 Foreground="{DynamicResource WarningBrush}" />
                    </Border>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{Binding Web.Message}" />
                  </StackPanel>
                </Border>

                <!-- Sharing the pool itself on the network, which is how a container reaches it. -->
                <TextBlock Text="Share this pool on the network" Style="{StaticResource Heading}"
                           Margin="0,20,0,2" />
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,4"
                           Text="Windows file sharing (SMB), managed by MergePool: the share is created when the pool is mounted and removed when it is not, so it comes back by itself after an update, a restart or a drive letter change. This is how Docker and WSL2 reach a pool — a container cannot use the drive letter, because there is no real disk behind it to recognise." />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                           Text="This shares the pool selected on the left." />

                <Border Style="{StaticResource InsetCard}">
                  <StackPanel>
                    <CheckBox IsChecked="{Binding Share.Enabled, Mode=TwoWay}" Margin="0,0,0,12"
                              IsEnabled="{Binding Share.HasPool}"
                              ToolTip="Shares this pool over SMB while it is mounted. Nothing is shared until you have named at least one Windows account below: MergePool will not share a pool to everyone, and will not guess which account your containers use.">
                      <TextBlock TextWrapping="Wrap" FontSize="13"
                                 Text="Share this pool over SMB while it is mounted. The share follows the mount, so nothing has to put it back." />
                    </CheckBox>

                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0">
                        <TextBlock Text="SHARE NAME" Style="{StaticResource Subheading}" />
                        <TextBox Text="{Binding Share.ShareName, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="What the share is called in \\machine\name. Leave it empty to use the pool's own name. Characters Windows will not take in a share name are replaced." />
                      </StackPanel>

                      <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <CheckBox IsChecked="{Binding Share.ReadOnly, Mode=TwoWay}" Content="Read-only"
                                  ToolTip="Clients can read the pool but not write to it, whatever the accounts below are otherwise allowed. Worth it for a media server that only ever plays files back." />
                      </StackPanel>
                    </Grid>

                    <TextBlock Text="WHO MAY CONNECT" Style="{StaticResource Subheading}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                               Text="Windows accounts, as MACHINE\user or just user. Use a dedicated local account for this rather than your own sign-in: containers will hold its password in a file. There is no share until at least one account is named." />

                    <ListBox ItemsSource="{Binding Share.Accounts}"
                             SelectedItem="{Binding Share.SelectedAccount, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" MaxHeight="110"
                             Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <TextBox Grid.Column="0" Text="{Binding Share.NewAccount, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="The account to allow, for example MERGEPOOL\poolsvc." />
                      <Button Grid.Column="2" Content="Allow" MinWidth="80"
                              Command="{Binding Share.AddAccountCommand}"
                              ToolTip="Grants this account access to the share. The account must already exist in Windows — MergePool does not create accounts." />
                      <Button Grid.Column="4" Content="Remove" MinWidth="88"
                              Style="{StaticResource DangerButton}"
                              Command="{Binding Share.RemoveAccountCommand}"
                              ToolTip="Takes the selected account's access away. Anything currently connected as that account loses the share." />
                    </Grid>

                    <!-- What the share is doing, in its own words. -->
                    <Border CornerRadius="{StaticResource ControlRadius}" Padding="11,9" Margin="0,0,0,12"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                      <TextBlock Text="{Binding Share.StateText}" TextWrapping="Wrap" FontSize="13"
                                 Foreground="{DynamicResource TextBrush}" />
                    </Border>

                    <Border CornerRadius="{StaticResource ControlRadius}" Padding="11,9" Margin="0,0,0,12"
                            Background="{DynamicResource WarningSoftBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                            Visibility="{Binding Share.FirewallNote, Converter={StaticResource NullToVisibility}}">
                      <TextBlock Text="{Binding Share.FirewallNote}" TextWrapping="Wrap" FontSize="12"
                                 Foreground="{DynamicResource WarningBrush}" />
                    </Border>

                    <StackPanel Visibility="{Binding Share.IsShared, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="FOR DOCKER AND WSL2" Style="{StaticResource Subheading}" />
                      <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                 Text="A Docker named volume, which Docker re-establishes every time a container starts. That is what makes it survive a reboot or a dropped session, where a mount inside the docker-desktop distro needs a script to put it back. Replace USER and PASSWORD with the account above." />

                      <Border CornerRadius="{StaticResource ControlRadius}" Padding="10,8" Margin="0,0,0,8"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding Share.DockerCommand}" Style="{StaticResource Numeric}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" />
                      </Border>

                      <StackPanel Orientation="Horizontal">
                        <Button Content="Copy the command" MinWidth="148" Margin="0,0,6,0"
                                Command="{Binding Share.CopyDockerCommand}"
                                ToolTip="Copies the docker volume create line to the clipboard, ready to paste into a terminal once you have put the account's password in it." />
                        <Button Content="Copy the path" MinWidth="120"
                                Command="{Binding Share.CopyPathCommand}"
                                ToolTip="Copies the share's address, for pasting into File Explorer on another machine or into a Compose file." />
                      </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{Binding Share.Message}" />
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- What MergePool does with your data -->
          <TabItem Header="Your files">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
              <StackPanel>
                <TextBlock Text="Where your files actually live" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,14"
                           Text="Everything in a pool is an ordinary file on one of its drives, inside a folder named .PoolPart-{GUID} at the root. Open that folder in Explorer and you will find your files, with normal names, permissions and timestamps. No database, no container, no proprietary format." />

                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="A file is never split" Style="{StaticResource Subheading}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Each file lives whole on one drive. Folders can span drives, but a single file never does — so one drive going missing costs you only the files that were on it, and those are still on it." />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Adding a drive that already has data" Style="{StaticResource Subheading}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Safe. MergePool only ever writes inside its own .PoolPart folder. Your existing files stay exactly where they are and are not visible through the pool, unless you explicitly tick the option to move them in — which is a rename within the same drive, never a copy across drives." />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Taking a drive back out" Style="{StaticResource Subheading}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Two ways, both safe. Remove it and its files stay on it as ordinary files. Or move its files onto the pool's other drives first — each one copied whole and only then removed from the old drive, and the drive stays in the pool if anything could not be moved." />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Updates" Style="{StaticResource Subheading}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="A new version is installed into its own folder beside the old one, and a single link is switched to point at it. Nothing is overwritten, your configuration is kept outside the program folder, and if the new version does not come up healthy the link is switched back automatically." />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource InsetCard}" Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}">
                  <StackPanel>
                    <TextBlock Text="MergePool is not a backup" Style="{StaticResource Subheading}"
                               Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}"
                               Text="Pooling drives does not make them redundant. If a drive dies, the files that were on it are gone — from the pool and from the drive alike. Keep a backup of anything irreplaceable, pooled or not." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>

      <!-- Last, so it draws over both cards and is the thing the mouse finds. -->
      <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}"
                    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                    MouseDoubleClick="OnSplitterDoubleClick" />
    </Grid>

    <!-- Status bar -->
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ProgressBar Grid.Column="0" Width="120" Height="4" IsIndeterminate="True" Margin="0,0,12,0"
                   Style="{StaticResource ThinUsageBar}" VerticalAlignment="Center"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

      <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

      <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" MinWidth="88" Margin="0"
              ToolTip="Asks the service for the drive and pool state now, rather than waiting for the next couple of seconds to pass. Reading only — it changes nothing. F5 does the same thing." />
    </Grid>
  </Grid>
</Window>
