<Window x:Class="MergePool.Ui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MergePool" Height="760" Width="1120" MinHeight="560" MinWidth="880"
        Background="#F5F5F5">

  <Window.Resources>
    <!-- A thin usage bar, used for both drives and pools. -->
    <Style x:Key="UsageBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="#0F6CBD" />
      <Setter Property="Background" Value="#E1E1E1" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="BorderBrush" Value="#E0E0E0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="MergePool" FontSize="22" FontWeight="SemiBold" />
      <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Style="{StaticResource Caption}">
        <Run Text="Service" /><Run Text=" " /><Run Text="{Binding ServiceVersion, Mode=OneWay}" />
      </TextBlock>
    </DockPanel>

    <!-- Problem banner: only shown when something actually needs the user -->
    <Border Grid.Row="1" Background="#FDE7E9" BorderBrush="#F1707A" BorderThickness="1"
            CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#8A1B22" />
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="1.15*" />
      </Grid.ColumnDefinitions>

      <!-- Left: pick drives and create a pool -->
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Drives" Style="{StaticResource Heading}" />
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap"
                     Margin="0,0,0,12"
                     Text="Tick the drives to pool, then create a new pool or add them to the one selected on the right. Existing files on them are left exactly where they are." />

          <!-- New pool settings -->
          <Border DockPanel.Dock="Bottom" Background="#F8F8F8" CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Pool name" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                  <TextBox Text="{Binding PoolName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Drive letter" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                  <ComboBox Width="80" Padding="6,4"
                            ItemsSource="{Binding AvailableMountLetters}"
                            SelectedItem="{Binding SelectedMountLetter}" />
                </StackPanel>
              </Grid>

              <CheckBox IsChecked="{Binding AdoptExistingContent}" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap"
                           Text="Also move each drive's existing files into the pool (stays on the same drive, nothing is copied)" />
              </CheckBox>

              <StackPanel Orientation="Horizontal">
                <Button Content="Create pool" MinWidth="140" Margin="0,0,8,0"
                        Background="#0F6CBD" Foreground="White" BorderThickness="0"
                        Command="{Binding CreatePoolCommand}" />

                <!-- Grows the pool selected on the right. The pool stays mounted throughout. -->
                <Button MinWidth="140" Content="{Binding AddDrivesLabel}"
                        Command="{Binding AddDrivesCommand}" />
              </StackPanel>

              <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Text="Adding drives keeps the pool mounted: the extra space appears straight away, and nothing already in the pool moves." />
            </StackPanel>
          </Border>

          <!-- Drive list -->
          <DataGrid ItemsSource="{Binding Drives}" AutoGenerateColumns="False" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                    Background="Transparent" RowBackground="Transparent" IsReadOnly="False"
                    SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="36">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanBePooled}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTextColumn Header="Drive" Binding="{Binding DriveLetter}" Width="60" IsReadOnly="True" />
              <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" IsReadOnly="True" />
              <DataGridTextColumn Header="Size" Width="90" IsReadOnly="True"
                                  Binding="{Binding TotalBytes, Converter={StaticResource ByteSize}}" />
              <DataGridTextColumn Header="Free" Width="90" IsReadOnly="True"
                                  Binding="{Binding FreeBytes, Converter={StaticResource ByteSize}}" />

              <DataGridTemplateColumn Header="Used" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ProgressBar Style="{StaticResource UsageBar}" VerticalAlignment="Center"
                                 Value="{Binding UsedFraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Header="Status" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <!-- Right: existing pools and their live per-drive status -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Pools" Style="{StaticResource Heading}" />

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Mount" Command="{Binding MountCommand}" />
            <Button Content="Unmount" Command="{Binding UnmountCommand}" />
            <Button Content="Rebalance" Command="{Binding RebalanceCommand}" />
            <Button Content="Remove pool" Command="{Binding RemovePoolCommand}" />
          </StackPanel>

          <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" TextWrapping="Wrap"
                     Margin="0,8,0,0"
                     Text="Removing a pool leaves every file on its drive, in the same folders." />

          <ListBox ItemsSource="{Binding Pools}" SelectedItem="{Binding SelectedPool}"
                   BorderThickness="0" Background="Transparent"
                   HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="1"
                        CornerRadius="6" Padding="12" Margin="0,0,0,8">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                 Text="{Binding MountPoint}" Foreground="#0F6CBD" FontWeight="SemiBold" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                      <Run Text="{Binding FreeBytes, Mode=OneWay, Converter={StaticResource ByteSize}}" />
                      <Run Text="free of" />
                      <Run Text="{Binding TotalBytes, Mode=OneWay, Converter={StaticResource ByteSize}}" />
                    </TextBlock>

                    <ProgressBar Style="{StaticResource UsageBar}" Margin="0,6,0,6"
                                 Value="{Binding UsedFraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />

                    <TextBlock Text="{Binding HealthSummary}" TextWrapping="Wrap"
                               Foreground="{Binding Health, Converter={StaticResource StatusBrush}}" />

                    <ItemsControl ItemsSource="{Binding Parts}" Margin="0,10,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="54" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="100" />
                              <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding DriveLetter}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                              <TextBlock Text="{Binding Label}" />
                              <ProgressBar Style="{StaticResource UsageBar}" Margin="0,4,0,0"
                                           Value="{Binding UsedFraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Throughput}" />
                              <TextBlock Text="{Binding HealthRatio}" Style="{StaticResource Caption}" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{Binding Status}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Status line -->
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <ProgressBar DockPanel.Dock="Left" Width="120" Height="4" IsIndeterminate="True" Margin="0,0,10,0"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Refresh"
              Command="{Binding RefreshCommand}" Margin="0" />
    </DockPanel>
  </Grid>
</Window>
