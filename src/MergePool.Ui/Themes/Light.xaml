<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Light palette. Every name here also exists in Dark.xaml. -->

  <SolidColorBrush x:Key="WindowBrush" Color="#F3F4F6" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="InsetBrush" Color="#F1F3F5" />
  <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#F0F2F5" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#E4E7EB" />

  <SolidColorBrush x:Key="BorderBrush" Color="#E3E6EA" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD1D8" />
  <SolidColorBrush x:Key="TrackBrush" Color="#E4E7EB" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3C9D0" />

  <SolidColorBrush x:Key="TextBrush" Color="#16191D" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#5C6670" />

  <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#115EA3" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#0E4F87" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F1FA" />

  <SolidColorBrush x:Key="SuccessBrush" Color="#0E700E" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E6F4E6" />
  <SolidColorBrush x:Key="WarningBrush" Color="#8A5700" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FDF3E0" />
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#E8C170" />
  <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDEBE9" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="#F0A9A2" />

  <!-- The part of a pool drive that is used by something other than the pool. -->
  <SolidColorBrush x:Key="ForeignBrush" Color="#9AA4AF" />

</ResourceDictionary>
