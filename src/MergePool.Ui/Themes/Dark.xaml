<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark palette. Same names as Light.xaml, so the theme swaps cleanly at runtime. -->

  <SolidColorBrush x:Key="WindowBrush" Color="#14171A" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#1D2125" />
  <SolidColorBrush x:Key="InsetBrush" Color="#262B31" />
  <SolidColorBrush x:Key="ControlBrush" Color="#262B31" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#303740" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#39414B" />

  <SolidColorBrush x:Key="BorderBrush" Color="#2C3238" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#3C444D" />
  <SolidColorBrush x:Key="TrackBrush" Color="#333A42" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A535D" />

  <SolidColorBrush x:Key="TextBrush" Color="#ECEFF2" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#9BA5B0" />

  <SolidColorBrush x:Key="AccentBrush" Color="#4AA3E8" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#5FB0EE" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#3B8DCE" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B2C3B" />

  <SolidColorBrush x:Key="SuccessBrush" Color="#6CC46C" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1B2C1B" />
  <SolidColorBrush x:Key="WarningBrush" Color="#E0AB4C" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#2F2718" />
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#5A4A27" />
  <SolidColorBrush x:Key="DangerBrush" Color="#F08076" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#33201E" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="#6B3B36" />

  <SolidColorBrush x:Key="ForeignBrush" Color="#5C6670" />

</ResourceDictionary>
