<Application x:Class="MergePool.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MergePool.Ui.Converters">
  <Application.Resources>
    <converters:ByteSizeConverter x:Key="ByteSize" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <converters:StatusBrushConverter x:Key="StatusBrush" />
    <converters:FractionToPercentConverter x:Key="FractionToPercent" />

    <Style TargetType="TextBlock" x:Key="Heading">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Caption">
      <Setter Property="Foreground" Value="#606060" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
  </Application.Resources>
</Application>
