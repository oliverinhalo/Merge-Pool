<Application x:Class="MergePool.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MergePool.Ui.Converters">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Palette first: the styles reference its brushes by name. Swapped at runtime by App. -->
        <ResourceDictionary Source="Themes/Light.xaml" />
        <ResourceDictionary Source="Themes/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <converters:ByteSizeConverter x:Key="ByteSize" />
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
      <converters:StatusBrushConverter x:Key="StatusBrush" />
      <converters:FractionToPercentConverter x:Key="FractionToPercent" />
      <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
      <converters:StatePillBrushConverter x:Key="StatePillBrush" />
      <converters:StateDotBrushConverter x:Key="StateDotBrush" />
      <converters:StateTextBrushConverter x:Key="StateTextBrush" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
