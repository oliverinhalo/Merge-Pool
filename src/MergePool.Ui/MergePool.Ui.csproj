<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon: WPF has no notification-area API of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MergePool.Ui</RootNamespace>
    <AssemblyName>MergePool</AssemblyName>
    <IsWindowsOnlyProject>true</IsWindowsOnlyProject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MergePool.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!--
      UseWindowsForms puts System.Windows.Forms into the implicit usings, which makes plain
      'Application' ambiguous with WPF's in every file. Only TrayPresence needs Windows Forms, and it
      imports it under an alias, so the global import is removed rather than qualified everywhere.
    -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\MergePool.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MergePool.Ipc\MergePool.Ipc.csproj" />
  </ItemGroup>

</Project>
